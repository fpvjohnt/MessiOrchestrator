# Root .env for the orchestrator's own infrastructure — the HTTP bridge that
# serves the phone, and the supervisor that watches it.
#
# Copy this file to ".env" and fill in MCP_BRIDGE_TOKEN. Everything else has a
# working default; the entries below document what each one changes.
#
# This is NOT where the search API keys go. research-mcp loads its own
# research-mcp/.env (see research-mcp/.env.example) — keys placed in this file
# never reach it.
#
# Both files are gitignored. This repo is public; keep it that way.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# The passphrase gating the OAuth approval page — the only thing between the
# public hostname and every asset behind it. The bridge refuses to start if it
# is missing or shorter than 32 characters, rather than run unprotected.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_BRIDGE_TOKEN=

# OPTIONAL: a SECOND, static, revocable bearer for a non-OAuth MCP client (e.g. an
# ElevenLabs Conversational AI voice agent) that can't do the interactive OAuth
# passphrase flow the phone uses. Checked (constant-time) before the OAuth path;
# leave blank to disable. Revoke by clearing this and restarting the bridge —
# the phone connector (which uses OAuth) is unaffected. Must be >=32 chars if set.
MCP_BRIDGE_AGENT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# SUPERVISOR AND ALERTS  (bridge/supervisor.mjs — reads this file directly)
# ─────────────────────────────────────────────────────────────────────────────

# Where outage alerts go when you are away from the machine. Desktop toasts and
# logs/alerts.log always happen; this is the only channel that reaches a phone.
# ntfy.sh needs no account — the topic name IS the credential, so make it
# unguessable. Anyone who guesses it can read your alerts (component names and
# failure reasons, not your data).
#   MCP_ALERT_WEBHOOK=https://ntfy.sh/some-name-nobody-would-guess
MCP_ALERT_WEBHOOK=

# ntfy (default) | slack | discord | json
MCP_ALERT_WEBHOOK_FORMAT=ntfy

# Set to 0 to silence Windows toast notifications.
MCP_ALERT_TOAST=1

# How often to repeat an alert while a component is still broken (default 30m).
# A long outage otherwise goes quiet once the restart backoff stretches out.
MCP_ALERT_REPEAT_MS=1800000

# Probe cadence, probe deadline, and how many consecutive failures before the
# supervisor kills and restarts a component. Two, not one: a single missed
# probe during a GC pause is not worth dropping live sessions over. The probe
# timeout is 15s (not 5s) because the bridge's deep /healthz spawns a throwaway
# orchestrator to prove it can actually serve; that is ~12s cold, cached 20s.
MCP_SUPERVISOR_INTERVAL_MS=30000
MCP_SUPERVISOR_PROBE_TIMEOUT_MS=15000
MCP_SUPERVISOR_FAILURES_BEFORE_RESTART=2

# How often the supervisor spawns an orchestrator and runs health_check across
# all 22 assets. Slow (hourly) because it spawns the whole fleet; the fast
# bridge/tunnel probes run every INTERVAL_MS. Alerts only on a DOWN asset.
MCP_SUPERVISOR_ASSET_CHECK_MS=3600000

# cloudflared's metrics port, where /ready reports live connections to the
# Cloudflare edge. Must match the --metrics flag in bridge/start-all.cmd —
# change one and you must change the other, or the probe reports a permanent
# outage on a healthy tunnel.
MCP_TUNNEL_METRICS_PORT=20241

# ─────────────────────────────────────────────────────────────────────────────
# BRIDGE  (bridge/server.mjs)
# ─────────────────────────────────────────────────────────────────────────────
#
# The bridge and the supervisor load this file through the same parser
# (bridge/load-env.mjs), so a setting here means the same thing to both. That
# was not always true: start-all.cmd used to extract MCP_BRIDGE_TOKEN alone and
# start node with nothing else, so everything below was read from an
# environment that could never contain it and silently used its default —
# while the supervisor, which did read this file, acted on the value. Setting
# MCP_BRIDGE_PORT moved the probe and not the listener, which is a permanent
# false outage, with restarts, against a healthy bridge.
#
# Changing the port still means changing it in ONE more place: the tunnel's
# ingress rule in %USERPROFILE%\.cloudflared\config.yml points at
# http://localhost:8787. Change only this and the tunnel keeps dialling the old
# port — the bridge is healthy, the supervisor agrees, and the phone still gets
# nothing.

# Port the bridge listens on (127.0.0.1 only; cloudflared dials out to it).
MCP_BRIDGE_PORT=8787

# Public origin. OAuth metadata and redirect URIs must use the external URL,
# not localhost, or the connector's discovery breaks.
MCP_BRIDGE_ISSUER=https://mcp.johntapia.com

# How many orchestrator processes the bridge keeps warm. Requests are routed to
# whichever is least busy, so this — not client behaviour — is the only thing
# that decides how much memory the bridge can occupy (~1.5GB per fully warmed
# worker once it has fanned out across the assets). Two suits one person with a
# phone and a desktop talking at once.
MCP_BRIDGE_WORKERS=2

# How long the bridge waits for a worker to answer one request. A research case
# can legitimately run for minutes; this only has to be shorter than "forever"
# so a wedged worker cannot pin a request permanently.
MCP_BRIDGE_REQUEST_TIMEOUT_MS=600000

# ── Retired with the stateless rewrite ──────────────────────────────────────
# MCP_BRIDGE_SESSION_IDLE_MS, MCP_BRIDGE_HANDSHAKE_GRACE_MS and
# MCP_BRIDGE_MAX_SESSIONS configured the idle reaper, the handshake-grace timer
# and the session cap. All three existed to bound processes that client
# behaviour was allowed to create; the worker pool bounds that by construction,
# so all three are gone. Setting them now does nothing.

# ─────────────────────────────────────────────────────────────────────────────
# ADVANCED
# ─────────────────────────────────────────────────────────────────────────────

# Where `npm run backup` writes. Default "backups" is on the same drive as the
# originals — it protects against accidental deletion and corruption, not drive
# failure. Point it at a cloud-synced folder or another drive for that, e.g.:
#   MCP_BACKUP_DIR=C:\Users\<you>\OneDrive\MCP-Backups
# backup-data.mjs loads .env itself, so this now takes effect for the scheduled
# run too (run-backup.cmd launches node with a bare environment).
MCP_BACKUP_DIR=

# Cross-process lock timings (src/file-lock.ts). Defaults are right for normal
# use; these exist so the regression suite can drive the stale and heartbeat
# paths without waiting out a 10-second window. The orchestrator is spawned by
# Claude Desktop with no environment, so setting them here does not reach it.
# MCP_LOCK_STALE_MS=10000
# MCP_LOCK_HEARTBEAT_MS=2000
# MCP_LOCK_TIMEOUT_MS=5000
# MCP_LOCK_RETRY_MS=50

# ─────────────────────────────────────────────────────────────────────────────
# youtube-mcp — NETWORKED asset (see AGENTS.md "Networked assets (exceptions)")
# ─────────────────────────────────────────────────────────────────────────────
# These go in youtube-mcp/.env, NOT here — the asset loads its own .env via
# youtube-mcp/src/env-file.ts, the same pattern research-mcp uses. Listed here so
# the full credential surface of the system is documented in one place.
#
# PUBLIC DATA (gates 7 of 11 tools: search, video/channel stats, comments,
# fast-growing, compare, topics). Google Cloud console -> enable "YouTube Data
# API v3" -> Credentials -> API key.
#   YOUTUBE_API_KEY=AIza...
#
# QUOTA REALITY, because it shapes how the tools may be used: search.list has its
# OWN bucket of 100 CALLS PER DAY (not 100 units out of 10,000), and paging costs
# another call. videos.list / channels.list / commentThreads.list are ~1 unit each
# against a separate 10,000/day pool, so stats and comments are effectively free
# and search is the scarce resource. youtube-mcp ledgers this in .cache/quota.json
# and caches searches for 6h; check it with the youtube_quota_status tool.
#
# OWNER-ONLY DEMOGRAPHICS (gates the 2 demographics tools). Age group, gender,
# country, device type and operating system come ONLY from the YouTube Analytics
# API, which requires OAuth AND ownership of the channel — Google's docs: "The
# user authorizing the request must be the owner of the channel." There is no
# API-key path and no way to get these for a channel you do not own.
# Enable "YouTube Analytics API", create a Desktop-app OAuth client, then run:
#   npm --prefix youtube-mcp run setup:oauth
#   YOUTUBE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
#   YOUTUBE_OAUTH_CLIENT_SECRET=...
#   YOUTUBE_OAUTH_REFRESH_TOKEN=...        # minted by setup:oauth
#   YOUTUBE_CHANNEL_ID=UC...               # optional; defaults to channel==MINE
#
# CAVEAT worth knowing before you trust the numbers: ageGroup and gender describe
# LOGGED-IN viewers only. Those percentages are shares of your signed-in audience,
# not of your audience, and gender has exactly three values (female, male,
# user_specified). Every tool response repeats this.
